#!/usr/bin/env bash
# pre-commit - the earliest catch, before a lane commit exists. On a lane
# branch: a lane's first commit never carries the placeholder requirement,
# REQUIREMENTS.md is regenerated from the staged requirement files and staged
# with them (lib/reqs.sh), and when dev's conf sets gates_commit, the staged
# tree must pass it (run on a copy of the index, so unstaged edits never
# change the verdict).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for l in core message version policy identity reqs; do . "$here/lib/$l.sh"; done
fail() { echo "X pre-commit: $*" >&2; exit 1; }
b=$(neo_branch)
case "$b" in lane/*) ;; *) exit 0 ;; esac
ks=$(neo_lane_parse "$b") || exit 0
set -- $ks; slug="$2"
dev=$(git rev-parse -q --verify refs/heads/dev) || exit 0
export NEO_CONF_REV="$dev"
if git cat-file -e ":requirements/$slug.md" 2>/dev/null \
   && git show ":requirements/$slug.md" | grep -F "$NEO_REQ_PLACEHOLDER" >/dev/null; then
  fail "requirements/$slug.md still holds the placeholder; state the requirement this lane meets and how its tests prove it, git add it, and commit again"
fi
# the register is generated: REQUIREMENTS.md follows the staged requirement files, staged with them
if ! err=$(neo_reqs_write_index 2>&1); then
  printf '%s\n' "$err" >&2
  fail "the requirement files break the register model (above); fix them and commit again"
fi
if [ -n "$(neo_conf gates_commit "")" ]; then
  tmp=$(neo_tmpdir commit)
  git checkout-index -a --prefix="$tmp/"
  if ! r=$(neo_gate commit "$tmp"); then rm -rf "$tmp"; fail "gates_commit fails on the staged tree (above); fix it before committing"; fi
  rm -rf "$tmp"
fi
exit 0
