#!/usr/bin/env bash
# commit-msg - the message rules (lib/message.sh) and the identity rules
# (lib/identity.sh, the map committed on dev) on every commit, and no commit
# on dev or main: those move only through 'neo land' and 'neo release'.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$here/lib/core.sh"; . "$here/lib/message.sh"; . "$here/lib/identity.sh"; . "$here/lib/audit.sh"
b=$(neo_branch)
case "$b" in
  dev|main)
    echo "X commit-msg: no commit on $b; start a lane (neo lane <kind> <slug>) and land it" >&2; exit 1 ;;
esac
out=$(neo_msg_violations "$1")
# the commit-audit smells that read the diff, on the staged change (an amend is judged against HEAD's parent)
base=HEAD
case " $(ps -o args= -p "$PPID" 2>/dev/null || true) " in *" --amend "*) base=HEAD^ ;; esac
if git rev-parse -q --verify "$base^{commit}" >/dev/null; then
  pr=0; [ -z "$(neo_trailer "$base" Red)" ] || pr=1
  sm=$(NEO_CONF_REV="$(git rev-parse -q --verify refs/heads/dev || true)" neo_diff_smells "$(grep -v '^#' "$1" | sed -n 1p)" "$(git diff --cached --numstat -M "$base")" "$pr")
  out=$(printf '%s\n%s\n' "$out" "$sm" | sed '/^$/d')
fi
# the author and committer are checked now, not first at land, so a lane is never written under a wrong identity
ai=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true); ci=$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)
an=$(sed -E 's/^(.*) <[^>]*>.*$/\1/' <<<"$ai"); ae=$(sed -nE 's/^.* <([^>]*)>.*$/\1/p' <<<"$ai")
ce=$(sed -nE 's/^.* <([^>]*)>.*$/\1/p' <<<"$ci")
export NEO_CONF_REV; NEO_CONF_REV=$(git rev-parse -q --verify refs/heads/dev || true)
idp=$(neo_identity_problem "$ae" "$an")
neo_identity_known "$ce" || idp="${idp:+$idp
}committer '$ce' is not a known identity"
pp=$(neo_identity_pair_problem "$ae" "$ce"); [ -z "$pp" ] || idp="${idp:+$idp
}$pp"
if [ -n "$out" ] || [ -n "$idp" ]; then
  echo "X commit-msg: the commit breaks the rules:" >&2
  printf '%s\n' "$out" "$idp" | sed '/^$/d; s/^/  - /' >&2
  [ -z "$out" ] || {
    echo "  Subject: [NEW|FIX|REFACTOR|DOCS|TEST|REVERT|HOTFIX] Capitalised summary, $NEO_SUBJ_MIN to $NEO_SUBJ_MAX chars, no final period." >&2
    echo "  A test-first commit that fails its test on purpose carries one trailer: Red: <test name>." >&2
    echo "  One concern per commit, with its test; a [FIX] body says Cause: then Fix: (RULES.md, Commits)." >&2; }
  [ -z "$idp" ] || echo "  Identities come from .neo/identity-map as committed on dev; an agent authors as '<name> (<Model>)'." >&2
  exit 1
fi
